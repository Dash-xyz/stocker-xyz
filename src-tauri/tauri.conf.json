{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stocker",
  "version": "0.1.0",
  "identifier": "com.stocker.desktop",
  "build": { "frontendDist": "../src/renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Stocker", "width": 500, "height": 700, "minWidth": 380, "minHeight": 500, "decorations": true, "transparent": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Finance",
    "shortDescription": "Fast cross-platform stock watchlist",
    "windows": { "nsis": { "displayLanguageSelector": false } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
